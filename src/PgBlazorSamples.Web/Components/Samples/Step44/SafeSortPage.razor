@page "/learn/44"
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject PgBlazorSamples.Web.Services.Learning.LearningPageService Pages
@inject LearningDbService DbSettings

<PageTitle>ステップ44：許可リストと複数列ソート｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">ステップ44 / 安全な動的ソート</p>
<h1>複数列ソートを安全にDBへ伝える</h1>
<MudPaper Class="pa-4" Elevation="1">
    <MudAlert Severity="Severity.Info" Dense="true">列名は許可リストのC#プロパティに変換します。自由なSQL文字列は作りません。</MudAlert>
    <p role="status" data-testid="step44-state">@_message</p>
    <MudDataGrid T="LearningTaskRow" ServerData="LoadAsync"
                 SortMode="SortMode.Multiple" Filterable="false" RowsPerPage="5" Dense="true">
        <Columns>
            <PropertyColumn Property="x => x.Title" Title="課題名"/>
            <PropertyColumn Property="x => x.DueDate" Title="期限日" Format="yyyy/MM/dd"/>
            <PropertyColumn Property="x => x.StartTime" Title="開始時刻"/>
            <PropertyColumn Property="x => x.Id" Title="番号"/>
        </Columns>
        <PagerContent><MudDataGridPager T="LearningTaskRow" PageSizeOptions="@(new int[] {5, 10, 20})"/></PagerContent>
    </MudDataGrid>
</MudPaper>
<section class="lesson-details">
    <h2>ソート条件をどう扱うか</h2>
    <p>SortDefinitionsのIndex順で最大3列のソートを適用し、最後に主キーIdを追加します。UIが不正な列名を送ってもLearningPageServiceが拒否します。</p>
    <p>ページ切替中に同じ値が並んでも重複や欠落を減らすため、安定した完全順序を作ります。</p>
</section>
<div class="page-navigation"><a href="/learn/43">前へ：ステップ43</a><a href="/learn/45">次へ：ステップ45</a></div>
@code {
    protected override void OnInitialized()
    {
        // ServerDataは子部品内のイベントなので、未設定を親画面で先に表示する。
        if (!DbSettings.Configured) _message = LearningDbService.NotConfigured;
    }

    private string _message = "初期表示を読み込みます。";

    private async Task<GridData<LearningTaskRow>> LoadAsync(GridState<LearningTaskRow> state, CancellationToken ct)
    {
        var sorts = state.SortDefinitions.OrderBy(x => x.Index)
            .Take(3).Select(x => new LearningSort(x.SortBy, x.Descending)).ToArray();
        var data = await Pages.LoadAsync(new(state.Page, state.PageSize, Sorts: sorts), ct);
        _message = data.Message + $" 総件数：{data.TotalCount} 件";
        await InvokeAsync(StateHasChanged);
        return new() { Items = data.Rows, TotalItems = data.TotalCount };
    }
}
