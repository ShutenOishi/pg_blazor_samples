@page "/learn/17"
@implements IDisposable
@inject ILogger<AsyncLoggingPage> Logger

<PageTitle>ステップ17：非同期とログ｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">学習順27 / 旧Step17 / 非同期処理</p>
<h1>処理の完了と取り消しを画面で観察する</h1>
<p>時間のかかる処理を模して、<code>Task.Delay</code> と <code>CancellationToken</code> を体験します。</p>
<section class="lesson-details">
  <h2>実行してみる</h2>
  <p role="status" data-testid="step17-state">@state</p>
  <div class="practice-actions">
    <button type="button" @onclick="StartAsync">非同期処理を開始する</button>
    <button type="button" @onclick="Cancel" disabled="@(!running)">処理を取り消す</button>
  </div>
  <p>完了時はILoggerへ機密情報を含まない学習用ログを出力します。</p>
</section>
<section class="lesson-details">
  <h2>注意点</h2>
  <p>Blazor Interactive Serverではサーバーでイベントが実行されます。画面を離れるときに処理を中断する設計が重要です。</p>
  <p>本教材は外部通信を行わず、実際の業務データをログに記録しません。</p>
</section>
<section class="lesson-details" aria-label="学習順27の比較と切り分け">
  <h2>WinForms＋Dapperとの比較</h2>
  <table data-testid="di06-compare-17">
    <thead><tr><th>対象</th><th>従来の設計</th><th>今回の実装</th></tr></thead>
    <tbody><tr><td>非同期処理</td><td>WinFormsではPCでイベント処理する</td><td>Blazorではサーバーでイベントを処理する</td></tr></tbody>
  </table>
  <h2>症状から切り分ける</h2>
  <table><thead><tr><th>症状・誤解</th><th>確認方法</th></tr></thead>
    <tbody><tr><td>取消の通知はDB更新の巻戻しではない</td><td>Task.Delayと現行処理を確認</td></tr></tbody></table>
  <p>実際のコードと詳しい解説、演習・解答は同じ学習順の日本語教材で確認します。</p>
</section>
<div class="page-navigation"><a href="/learn/16">前へ：ステップ16</a><a href="/learn/18">次へ：ステップ18</a></div>
@code {
    private string state = "まだ実行していません。";
    private CancellationTokenSource? cancellation;
    private bool running;

    private async Task StartAsync()
    {
        // 二重実行では古い処理を中断してから新しい処理を開始します。
        cancellation?.Cancel();
        cancellation?.Dispose();
        cancellation = new CancellationTokenSource();
        var current = cancellation;
        running = true;
        state = "処理中です。";
        try
        {
            await Task.Delay(800, current.Token);
            if (ReferenceEquals(cancellation, current))
            {
                state = "処理が完了しました。";
                Logger.LogInformation("ステップ17の練習用非同期処理が完了しました。");
            }
        }
        catch (OperationCanceledException)
        {
            if (ReferenceEquals(cancellation, current))
                state = "処理を取り消しました。";
        }
        finally
        {
            if (ReferenceEquals(cancellation, current)) running = false;
        }
    }

    private void Cancel()
    {
        cancellation?.Cancel();
        state = "処理を取り消しました。";
    }

    public void Dispose()
    {
        cancellation?.Cancel();
        cancellation?.Dispose();
    }
}
