@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Cryptography
@page "/learn/browser-02"
<PageTitle>学習順042：ファイルアップロードと入力制約｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">第4段階 / 学習順042</p>
<h1>ファイルアップロードと入力制約</h1>

<p>WinFormsでローカルのファイルを開く操作と異なり、Webではブラウザーからサーバーへファイルの内容が送信されます。</p>
<section class="lesson-details">
    <h2>小さなテキストを検査する</h2>
    <label for="browser02-file">練習用ファイル（.txt または .csv、最大64 KiB）</label>
    <InputFile id="browser02-file" OnChange="InspectFile" accept=".txt,.csv,text/plain,text/csv" />
    <p data-testid="browser02-result" role="status">@result</p>
    @if (digest is not null)
    {
        <p>受信した内容のSHA-256：<code data-testid="browser02-hash">@digest</code></p>
    }
    <p>内容はメモリで検査するだけで、サーバーのディスクやDBには保存しません。実業務では本人認可・ウイルス検査・保存先分離も必要です。</p>
</section>
<section class="lesson-details">
    <h2>検査すべき境界</h2><ol>
        <li>ブラウザーの accept は選択補助であり、セキュリティ検証の代わりではありません。</li>
        <li>サーバーでファイルの拡張子とサイズを検査します。MIMEやファイル名は信用しません。</li>
        <li>OpenReadStream に読み取り上限を渡します。名前を保存先パスとして使いません。</li>
        <li>本番でのファイル内容・マルウェア検証はこの練習には含みません。</li>
    </ol></section>
<div class="page-navigation"><a href="/learn/browser-01">前へ</a><a href="/learn/browser-03">次へ</a></div>
@code {
    private const long Limit = 64 * 1024;
    private string result = "ファイルを選択してください。";
    private string? digest;

    private async Task InspectFile(InputFileChangeEventArgs args)
    {
        digest = null;
        var file = args.File;
        var ext = Path.GetExtension(file.Name);
        // 拡張子とサイズはサーバーで検査し、入力メタデータだけを信用しない。
        if (ext is not ".csv" and not ".txt")
        {
            result = "拒否：.txt または .csv のみ選択できます。";
            return;
        }
        if (file.Size > Limit)
        {
            result = "拒否：64 KiBを超えるファイルは受け付けません。";
            return;
        }
        try
        {
            await using var input = file.OpenReadStream(maxAllowedSize: Limit);
            using var output = new MemoryStream();
            await input.CopyToAsync(output);
            var bytes = output.ToArray();
            digest = Convert.ToHexString(SHA256.HashData(bytes));
            result = $"検査完了：{bytes.Length} バイトを読み取りました。保存はしていません。";
        }
        catch (IOException)
        {
            result = "拒否：ファイルの読み取りに失敗しました。";
        }
        catch (InvalidOperationException)
        {
            result = "拒否：許可されたサイズを超えました。";
        }
    }
}
