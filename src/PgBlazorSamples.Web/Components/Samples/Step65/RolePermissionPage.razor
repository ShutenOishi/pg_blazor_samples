@page "/learn/65"
@using PgBlazorSamples.Web.Services.Learning
@inject WindowsUserAccessService UserAccess
<PageTitle>ステップ65：役割と操作権限｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">ステップ65 / Windows認証と業務利用の境界</p>
<h1>役割と操作権限</h1>
<MudPaper Class="pa-4">
    <h2>DBロールから許可操作を求める</h2>
    <p>app_user_roleとapp_role_permissionをたどって許可コードを取得します。無効ロールを除外し、都度DBから評価します。</p>
    <MudButton Color="Color.Primary" OnClick="InspectAsync">現在の認証・DB照合状態を確認</MudButton>
    <p role="status" data-testid="step65-state">@_snapshot.Message</p>
    <p>許可の結果：@_snapshot.SidHint</p>
    @if (!string.IsNullOrWhiteSpace(_snapshot.DisplayName))
    {
        <p>DB上の表示名：@_snapshot.DisplayName</p>
    }
    @if (true && _snapshot.Roles is { Count: > 0 })
    {
        <h3>有効なロール</h3>
        <ul>@foreach (var role in _snapshot.Roles) { <li>@role</li> }</ul>
        <h3>許可コード</h3>
        <ul>@foreach (var code in _snapshot.Permissions ?? Array.Empty<string>()) { <li>@code</li> }</ul>
    }
</MudPaper>
<section class="lesson-details">
    <h2>安全に確認する</h2>
    <p>画面表示だけを制御しても認可ではありません。Step66〜70で全業務操作へ適用します。</p>
    <details><summary>確認問題：本人認証が成功したら業務データを参照できる？</summary>
        <p>いいえ。アプリ利用者の有効性と、操作に対する権限をサーバー側で確認します。</p>
    </details>
    <p>この教材画面は開発用の理解確認です。実際のドメイン接続・IIS・KerberosはStep70で実機検証します。</p>
</section>
<div class="page-navigation"><a href="/learn/64">前のステップへ</a><a href="/learn/column/65">次へ進む</a></div>
@code {
    private WindowsAccessSnapshot _snapshot = new("initial", "ボタンを押すと認証とDB照合の状態を確認します。");

    private async Task InspectAsync()
    {
        _snapshot = await UserAccess.ReadCurrentAsync();
    }
}
