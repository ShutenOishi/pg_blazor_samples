@page "/learn/094"
@page "/learn/69"
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject SecuredLearningService Business
<PageTitle>ステップ69：権限付き編集｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">学習順094 / 第7段階・第19組（旧Step69）</p>
<h1>編集時にも認可と競合を確認する</h1>
<MudPaper Class="pa-4">
    <label for="edit-id">編集する架空課題の番号</label>
    <input id="edit-id" type="number" min="1" @bind="_id" />
    <MudButton Color="Color.Primary" OnClick="LoadAsync">認可付き詳細を取得する</MudButton>
    @if (_detail?.Item is not null)
    {
        <div><label for="edit-title">課題名</label><input id="edit-title" @bind="_title" maxlength="100" /></div>
        <MudButton Color="Color.Secondary" OnClick="SaveAsync">更新権限とxminを再確認して保存する</MudButton>
    }
    <p role="status" data-testid="step69-state">@_status</p>
</MudPaper>
<section class="lesson-details">
    <h2>確認ポイント</h2>
    <p>閲覧だけを許された利用者は保存できません。DB側の部署条件に一致しないIDも読み取り・更新できず、競合時は上書きしません。</p>
    <p>一括更新も権限と版を全件確認し、途中の1件だけを確定しません。</p>
    <h2>WinForms＋DapperとBlazorの認可比較</h2>
    <table data-testid="stage07-compare-94"><thead><tr><th>視点</th><th>WinForms＋Dapper</th><th>Blazor＋EF Core</th></tr></thead><tbody>
        <tr><td>保存</td><td>SQL実行時に既存台帳の操作権限と部署条件を確認する</td><td>can_edit・部署・xminを再確認</td></tr>
        <tr><td>安全拒否</td><td>ボタンの無効化だけで業務データを保護しない</td><td>原子性不明・競合・監査失敗は拒否</td></tr>
        <tr><td>現地受入</td><td>Windows端末・DB運用の検査を別に行う</td><td>実AD・IIS・Kerberos・FDWと1万人超負荷は未完了</td></tr>
    </tbody></table>
    <p>教材本文は学習順094です。正本台帳の都度認可、監査、失効時の安全拒否を確認してください。</p>
</section>
<div class="page-navigation"><a href="/learn/68">前へ：学習順093</a><a href="/learn/70">次へ：学習順095</a></div>
@code {
    private long _id = 1;
    private LearningDetailResult? _detail;
    private string _title = "";
    private string _status = "操作前です。";
    private async Task LoadAsync()
    {
        _detail = await Business.GetDetailAsync(_id);
        _title = _detail.Item?.Title ?? "";
        _status = _detail.Message;
    }
    private async Task SaveAsync()
    {
        var item = _detail?.Item;
        if (item is null) return;
        var result = await Business.SaveAsync(new LearningEditInput {
            Id = item.Id, Title = _title, IsDone = item.IsDone, Version = item.Version
        });
        _status = result.Message;
        if (result.Status == LearningEditStatus.Success)
            await LoadAsync();
    }
}
