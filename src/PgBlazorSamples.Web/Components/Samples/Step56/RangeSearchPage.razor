@page "/learn/076"
@page "/learn/56"
@using System.Globalization
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject LearningRangeExportService Ranges
@inject LearningDbService Database
<PageTitle>ステップ56：期間Range検索｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">学習順076 / DateRange・PostgreSQL daterange</p>
<h1>日本語の日付範囲とDBの期間の重なりを検索する</h1>
<MudPaper Class="pa-4">
    <MudDateRangePicker Label="検索期間（開始日〜終了日）" @bind-DateRange="_range"
                        Culture="@Japanese" DateFormat="yyyy/MM/dd" Clearable="true"/>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_working" OnClick="SearchAsync">期間の重なりを検索</MudButton>
    <p role="status" data-testid="step56-state">@_message</p>
    <MudTable T="LearningTaskRow" Items="_rows" Dense="true">
        <HeaderContent><MudTh>番号</MudTh><MudTh>課題名</MudTh><MudTh>期限</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>@context.Id</MudTd><MudTd>@context.Title</MudTd>
            <MudTd>@(context.DueDate?.ToString("yyyy/MM/dd") ?? "未設定")</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>表示できる課題はありません。</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>
<section class="lesson-details">
    <h2>期限日と期間列は別の意味</h2>
    <p>DueDateは単一のdate、AvailableDatesはdaterangeです。画面の終端を含む指定は、SQL検索で翌日を上端とする半開区間に直します。範囲が重なる行だけを抽出し、最大20行だけ表示します。</p>
    <p>NULL期間・開始が終了より後・過大な期間を否定試験します。データがないときとDB未設定を区別します。実業務では必ず行単位の認可を追加してください。</p>

    <h2>学習順076：WinForms＋Dapperとの比較</h2>
    <table data-testid="stage06-compare-076">
        <thead><tr><th>比較</th><th>WinForms＋Dapper</th><th>Blazor＋EF Core 10</th></tr></thead>
        <tbody>
            <tr><td>イベント</td><td>端末フォームの操作</td><td>サーバーのRazorイベントからサービスを呼ぶ</td></tr>
            <tr><td>今回の処理</td><td>日本語日付範囲とDB検索のSQLと表示を管理</td><td>日本語日付範囲とDB検索を学習用サービスで処理</td></tr>
            <tr><td>DBの接続</td><td>NpgsqlConnectionとSQLパラメーター</td><td>DbContextFactoryとLINQ／Npgsql</td></tr>
            <tr><td>認可</td><td>業務台帳を都度照合</td><td>この学習画面は未実装、本番では既存台帳を操作・行ごと確認</td></tr>
        </tbody>
    </table>
    <p>実コード・操作手順・障害の切り分け・演習と詳しい解答は docs/samples/step56.md に収録しています。</p>
</section>
<div class="page-navigation"><a href="/learn/column/55">前へ：第15組の復習</a><a href="/learn/57">次へ：ステップ57</a></div>
@code {
    private static readonly CultureInfo Japanese = CultureInfo.GetCultureInfo("ja-JP");
    private DateRange _range = new(new DateTime(2026, 10, 1), new DateTime(2026, 11, 30));
    private IReadOnlyList<LearningTaskRow> _rows = [];
    private string _message = "検索範囲を選択してください。";
    private bool _working;

    protected override void OnInitialized()
    {
        if (!Database.Configured) _message = LearningDbService.NotConfigured;
    }

    private async Task SearchAsync()
    {
        if (_working) return;
        if (_range?.Start is null || _range.End is null)
        {
            _message = "開始日と終了日の両方を指定してください。";
            return;
        }
        _working = true;
        try
        {
            var from = DateOnly.FromDateTime(_range.Start.Value);
            var to = DateOnly.FromDateTime(_range.End.Value);
            var result = await Ranges.FindOverlapsAsync(from, to);
            _rows = result.Rows;
            _message = result.Message + $" 総件数：{result.TotalCount}件、表示は最大20件。";
        }
        catch (ArgumentException ex)
        {
            _rows = [];
            _message = ex.Message;
        }
        finally { _working = false; }
    }
}
