@page "/learn/031"
@page "/learn/21"
@inject ISnackbar Snackbar

<PageTitle>ステップ21：MudBlazor導入と日本語化｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">学習順031 / ステップ21 / MudBlazor導入</p>
<h1>MudBlazorの部品と日本語メッセージを使う</h1>
<p>サービス登録、Provider、CSS・JavaScript、対話型描画、翻訳を組み合わせて動かします。</p>
<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6">日本語UIの実習</MudText>
    <MudAlert Severity="Severity.Info" Class="my-3">この画面は、社内データを使わない練習用です。</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Notify">日本語の通知を表示する</MudButton>
    <p role="status" data-testid="step21-state">@message</p>
</MudPaper>
<section class="lesson-details">
    <h2>今回利用するDI</h2>
    <p><code>AddMudServices()</code>はMudBlazorの機能を登録し、<code>AddMudTranslations()</code>は翻訳を登録します。</p>
    <p>通知は自作せず、<code>ISnackbar</code>をDIで受け取り、共通レイアウトのProviderに表示させます。</p>
</section>
<section class="lesson-details" data-testid="mud07-compare-21">
<h2>学習順031：WinForms＋Dapperとの比較と切り分け</h2>
<table><thead><tr><th scope="col">学習の視点</th><th scope="col">確認する内容</th></tr></thead><tbody>
<tr><th scope="row">DI</th><td>ライブラリのAddMudServicesとAddMudTranslationsを確認。</td></tr>
<tr><th scope="row">通知Provider</th><td>ISnackbarの通知要求と表示場所を区別。</td></tr>
<tr><th scope="row">翻訳</th><td>共通文言と独自の日本語メッセージは別。</td></tr>
</tbody></table>
<p>実コードの状態を確認し、ブラウザーでの操作、サーバーでの実行、DBでの保存を混同しないでください。結果が変わらないときは対話型接続とイベントの更新箇所を先に調べます。</p>
</section>
<div class="page-navigation"><a href="/learn/column/library-di">前へ：特別コラム05</a><a href="/learn/22">次へ：ステップ22</a></div>

@code {
    private string message = "まだ通知していません。";

    private void Notify()
    {
        // MudBlazorが提供する通知サービスを直接利用する。
        Snackbar.Add("日本語の通知が表示されました。", Severity.Success);
        message = "通知サービスを使いました。";
    }
}
