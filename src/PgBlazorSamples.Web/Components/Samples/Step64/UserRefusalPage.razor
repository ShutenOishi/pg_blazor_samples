@page "/learn/089"
@page "/learn/64"
@using PgBlazorSamples.Web.Services.Learning
@inject WindowsUserAccessService UserAccess
<PageTitle>ステップ64：未登録・無効利用者の拒否｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">学習順89（旧Step64） / Windows認証と業務利用の境界</p>
<h1>未登録・無効利用者の拒否</h1>
<MudPaper Class="pa-4">
    <h2>例外時もアクセスを拒否する</h2>
    <p>未認証・ドメイン付きユーザー名欠落・未登録・無効・DB障害・権限なしをすべて拒否します。</p>
    <MudButton Color="Color.Primary" OnClick="InspectAsync">現在の認証・既存台帳照合状態を確認</MudButton>
    <p role="status" data-testid="step64-state">@_snapshot.Message</p>
    <p>拒否判定：@_snapshot.IdentityHint</p>
    @if (!string.IsNullOrWhiteSpace(_snapshot.DisplayName))
    {
        <p>既存台帳の表示名：@_snapshot.DisplayName</p>
    }
    @if (false && _snapshot.Roles is { Count: > 0 })
    {
        <h3>有効なロール</h3>
        <ul>@foreach (var role in _snapshot.Roles) { <li>@role</li> }</ul>
        <h3>許可コード</h3>
        <ul>@foreach (var permissionCode in _snapshot.Permissions ?? Array.Empty<string>()) { <li>@permissionCode</li> }</ul>
    }
    <table data-testid="stage07-compare-89"><thead><tr><th>比較</th><th>WinForms＋Dapper</th><th>Blazorサーバー</th></tr></thead><tbody><tr><td>本人と台帳</td><td>端末の主体とSQLの認可を区別</td><td>認証済みPrincipalと既存台帳を都度照合</td></tr><tr><td>安全拒否</td><td>許可できない操作は実行しない</td><td>未登録・失効・DB障害なら拒否</td></tr></tbody></table>
</MudPaper>
<section class="lesson-details">
    <h2>安全に確認する</h2>
    <p>この時点ではStep31〜60のDBサービスを保護していません。実業務データは使用禁止です。</p>
    <details><summary>確認問題：本人認証が成功したら業務データを参照できる？</summary>
        <p>いいえ。既存台帳の利用者の有効性と、操作に対する権限をサーバー側で確認します。</p>
    </details>
    <p>この教材画面は開発用の理解確認です。実際のドメイン接続・IIS・KerberosはStep70で実機検証します。</p>
</section>
<div class="page-navigation"><a href="/learn/63">前のステップへ</a><a href="/learn/65">次へ進む</a></div>
@code {
    private WindowsAccessSnapshot _snapshot = new("initial", "ボタンを押すと認証と既存台帳照合の状態を確認します。");

    private async Task InspectAsync()
    {
        _snapshot = await UserAccess.ReadCurrentAsync();
    }
}
