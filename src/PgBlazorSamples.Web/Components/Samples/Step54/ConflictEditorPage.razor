@page "/learn/54"
@using Microsoft.AspNetCore.Components.Forms
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject LearningDbService Database
@inject LearningEditService Edits

<PageTitle>ステップ54：xmin競合の画面設計｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">ステップ54 / 競合・削除・再読み込み</p>
<h1>同時編集で古い変更を上書きしない</h1>
<p>同じ行を2つのブラウザーで開いてから先に片方で保存し、後からもう片方で保存してください。</p>
<MudPaper Class="pa-4">
    <MudButton OnClick="RefreshAsync">一覧を再読み込み</MudButton>
    <p role="status" data-testid="step54-state">@_message</p>
    <MudTable T="LearningTaskRow" Items="_rows" Dense="true">
        <HeaderContent><MudTh>課題名</MudTh><MudTh>操作</MudTh></HeaderContent>
        <RowTemplate><MudTd>@context.Title</MudTd>
            <MudTd><MudButton OnClick="@(() => ChooseAsync(context.Id))">編集を開始</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
    @if (_draft is not null)
    {
        <EditForm Model="_draft" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <label for="step54-title">編集中の課題名</label>
            <InputText id="step54-title" @bind-Value="_draft.Title" />
            <ValidationMessage For="@(() => _draft.Title)" />
            <p>読込時のxmin：@_draft.Version</p>
            <MudButton ButtonType="ButtonType.Submit" Disabled="_saving">変更を保存する</MudButton>
            <MudButton ButtonType="ButtonType.Button" OnClick="ReloadSelectedAsync">最新状態に読み替える</MudButton>
        </EditForm>
    }
    @if (_current is not null)
    {
        <p role="alert">DBの最新タイトル：@_current.Title（版 @_current.Version）</p>
    }
</MudPaper>
<section class="lesson-details">
    <h2>競合時に自動上書きしない</h2>
    <p>画面の版番号とDBのxminを照合し、保存直前のDbUpdateConcurrencyExceptionも捕捉します。競合時は最新値を別表示し、利用者が読み替えるまで編集データを勝手に変更しません。削除済みなら保存できません。</p>
</section>
<div class="page-navigation"><a href="/learn/53">前へ：ステップ53</a><a href="/learn/55">次へ：ステップ55</a></div>
@code {
    private IReadOnlyList<LearningTaskRow> _rows = [];
    private LearningEditInput? _draft;
    private LearningEditInput? _current;
    private string _message = "一覧を読み込みます。";
    private bool _saving;

    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private async Task RefreshAsync()
    {
        var rows = await Database.SearchAsync();
        _rows = rows.Rows;
        _message = rows.Message;
    }
    private async Task ChooseAsync(long id)
    {
        var loaded = await Edits.LoadAsync(id);
        _draft = loaded.Item;
        _current = null;
        _message = loaded.Message;
    }
    private async Task ReloadSelectedAsync()
    {
        if (_draft is not null) await ChooseAsync(_draft.Id);
    }
    private async Task SaveAsync()
    {
        if (_saving || _draft is null) return;
        _saving = true;
        try
        {
            var result = await Edits.SaveAsync(_draft);
            _message = result.Message;
            _current = result.Status == LearningEditStatus.Conflict ? result.Current : null;
            if (result.Status == LearningEditStatus.Success)
            {
                _draft = result.Current;
                await RefreshAsync();
                _message = result.Message;
            }
        }
        finally { _saving = false; }
    }
}
