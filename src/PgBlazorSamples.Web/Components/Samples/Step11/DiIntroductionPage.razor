@page "/learn/11"
@using PgBlazorSamples.Web.Services.Clock
@inject GreetingService Greeting

<PageTitle>ステップ11：DIとは何か｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">ステップ11 / 依存性注入</p>
<h1>部品を直接作る方法と、DIで受け取る方法を比べる</h1>
<p>DI（依存性注入）は、必要な部品を自分で作らず、外側で用意して渡してもらう仕組みです。</p>

<section class="lesson-details">
    <h2>2つの方法で挨拶を表示</h2>
    <div class="practice-actions">
        <button type="button" @onclick="Refresh">時刻を読み直す</button>
    </div>
    <dl class="value-list">
        <div><dt>直接作成した時計</dt><dd data-testid="step11-direct">@directMessage</dd></div>
        <div><dt>DIで受け取る時計</dt><dd data-testid="step11-injected">@injectedMessage</dd></div>
    </dl>
    <p class="hint">どちらも同じ時刻を使います。違いは「部品の用意の仕方」です。</p>
</section>
<section class="lesson-details">
    <h2>コードの注目点</h2>
    <p><code>new SystemClock()</code> は画面側で部品を直接作ります。</p>
    <p><code>@@inject GreetingService Greeting</code> は事前に登録したサービスを受け取ります。</p>
    <p>今は結果が似ていますが、後から時計の実装を交換したい場合に違いが表れます。</p>
</section>
<div class="page-navigation">
    <a href="/learn/10">前へ：ステップ10</a>
    <a href="/learn/12">次へ：ステップ12</a>
</div>
@code {
    private string directMessage = "";
    private string injectedMessage = "";

    protected override void OnInitialized() => Refresh();

    private void Refresh()
    {
        // DIを使用しない場合：画面が必要な時計を直接作成しています。
        directMessage = new GreetingService(new SystemClock()).GetMessage();

        // DIを使用する場合：外側で組み立てたサービスを利用します。
        injectedMessage = Greeting.GetMessage();
    }
}
