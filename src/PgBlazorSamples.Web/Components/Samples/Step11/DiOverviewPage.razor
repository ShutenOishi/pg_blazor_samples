        <tr><td><a href="/learn/11">021</a></td><td>DIの基本</td><td>直接生成と注入による挨拶</td></tr>
        <tr><td><a href="/learn/12">022</a></td><td>インターフェイス</td><td>固定時計の切替</td></tr>
