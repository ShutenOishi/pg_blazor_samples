@page "/learn/52"
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject LearningDbService Database
@inject LearningEditService Edits
@inject IDialogService Dialogs

<PageTitle>ステップ52：編集ダイアログ｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">ステップ52 / Dialog・保存・取消</p>
<h1>入力と保存の責任をダイアログにまとめる</h1>
<p>編集フォームは子コンポーネントです。取消はDBを書き換えず、成功したときだけ一覧を読み直します。</p>
<MudPaper Class="pa-4">
    <MudButton OnClick="ReloadAsync">一覧を再読み込み</MudButton>
    <p role="status" data-testid="step52-state">@_message</p>
    <MudTable T="LearningTaskRow" Items="_rows" Dense="true">
        <HeaderContent><MudTh>課題名</MudTh><MudTh>操作</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>@context.Title</MudTd>
            <MudTd><MudButton OnClick="@(() => ShowAsync(context.Id))">ダイアログで編集</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>
<section class="lesson-details">
    <h2>ライブラリDIを使う</h2>
    <p>IDialogServiceとMudDialogProviderを使います。Dialogは編集DTOのコピーを受け取り、成功したときだけ結果を返します。二重送信をガードし、保存前の入力検証はサーバー側でも行います。</p>
</section>
<div class="page-navigation"><a href="/learn/51">前へ：ステップ51</a><a href="/learn/53">次へ：ステップ53</a></div>
@code {
    private IReadOnlyList<LearningTaskRow> _rows = [];
    private string _message = "一覧を読み込みます。";

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        var list = await Database.SearchAsync();
        _rows = list.Rows;
        _message = list.Message;
    }

    private async Task ShowAsync(long id)
    {
        var edit = await Edits.LoadAsync(id);
        _message = edit.Message;
        if (edit.Item is null) return;

        var parameters = new DialogParameters { ["Model"] = edit.Item };
        var dialog = await Dialogs.ShowAsync<EditDialog>("課題の編集", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
            _message = "保存したため一覧を更新しました。";
        }
        else _message = "取消しました。DBは変更していません。";
    }
}
