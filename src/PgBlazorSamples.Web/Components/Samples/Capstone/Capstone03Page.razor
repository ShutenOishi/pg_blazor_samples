@page "/learn/108"
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject SecuredLearningService Business
@page "/learn/capstone-03"
<PageTitle>学習順108：DTO編集・競合・取消・例外の統合｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">第9段階 / 学習順108</p>
<h1>DTO編集・競合・取消・例外の統合</h1>

<p>表示済みの値ではなく、本人認証と既存台帳の最新の操作権限、対象部署とxminの版を使います。取消はDBへ書き込まず、保存時は共通サービスの認可・監査とトランザクションを使います。</p>
<section class="lesson-details">
<label for="capstone03-id">編集する課題番号</label>
<input id="capstone03-id" type="number" min="1" @bind="_id" disabled="@(_loading || _gate.IsBusy)" />
<button type="button" @onclick="LoadAsync" disabled="@(_loading || _gate.IsBusy)">認可付き詳細を取得する</button>
@if (_detail?.Item is { } item)
{
  <p>編集中の課題番号：@item.Id、読み取った版：@item.Version</p>
  <label for="capstone03-title">課題名（最大100文字）</label>
  <input id="capstone03-title" maxlength="100" @bind="_title" disabled="@(_loading || _gate.IsBusy)" />
  <label><input type="checkbox" @bind="_isDone" disabled="@(_loading || _gate.IsBusy)" /> 完了</label>
  <button type="button" @onclick="SaveAsync" disabled="@(_loading || _gate.IsBusy)">権限と競合を再検査して保存する</button>
  <button type="button" @onclick="Cancel" disabled="@(_loading || _gate.IsBusy)">編集を取り消す</button>
}
<p role="status" data-testid="capstone03-result">@_status</p>
<details><summary>確認：表示後に部署権限が失効した場合は？</summary><p>SaveAsyncが保存直前に正本を再検査し、権限行ロック・xmin・監査記録を同一トランザクションで保証できなければ拒否します。</p></details>
<table data-testid="capstone-compare-108"><thead><tr><th scope="col">観点</th><th scope="col">WinForms＋Dapper</th><th scope="col">Blazor／EF Core／既存台帳</th></tr></thead><tbody><tr><td>操作</td><td>フォームイベントでSQLを呼ぶ</td><td>Razorから認可済み業務サービスに委譲する</td></tr><tr><td>認可</td><td>既存DB台帳を照会する</td><td>認証済み本人・部署・操作と行単位を都度確認する</td></tr><tr><td>安全拒否</td><td>例外・排他・監査を確認する</td><td>権限失効、xmin競合、監査不成立、FDW原子性不明では拒否する</td></tr></tbody></table><p>解説は <code>docs/course-v3/lessons/capstone-03.md</code> を参照してください。実AD/IIS/Kerberos/FDWと1万人超負荷の実機受入は別途必要です。</p>
</section>
<div class="page-navigation"><a href="/learn/107">前へ</a><a href="/learn/109">次へ</a></div>
@code {
    private long _id = 1;
    private string _title = "";
    private bool _isDone;
    private string _status = "未読込です。";
    private LearningDetailResult? _detail;
    private bool _loading;
    private readonly L108SubmissionGate _gate = new();

    private async Task LoadAsync()
    {
        if (_loading || _gate.IsBusy) return;
        _loading = true;
        try
        {
            _detail = null;
            _title = "";
            _isDone = false;
            if (_id <= 0) { _status = "1以上の番号を指定してください。"; return; }
            await LoadDetailCoreAsync(_id);
        }
        finally { _loading = false; }
    }

    private async Task LoadDetailCoreAsync(long id)
    {
        var result = await Business.GetDetailAsync(id);
        _detail = result.Item is null ? null : result;
        _title = result.Item?.Title ?? "";
        _isDone = result.Item?.IsDone ?? false;
        _status = result.Message;
    }

    private void Cancel()
    {
        if (_loading || _gate.IsBusy) return;
        _detail = null;
        _title = "";
        _isDone = false;
        _status = "編集を取り消しました。DBの値は変更していません。";
    }

    private async Task SaveAsync()
    {
        // 二重送信は画面で抑止し、サーバー側も権限・xmin・監査を毎回検査する。
        if (_loading || !_gate.TryBegin()) return;
        try
        {
            var item = _detail?.Item;
            if (item is null) { _status = "保存対象はありません。"; return; }
            if (string.IsNullOrWhiteSpace(_title) || _title.Trim().Length > 100)
            { _status = "課題名は1〜100文字で入力してください。"; return; }
            var result = await Business.SaveAsync(new LearningEditInput
            { Id = item.Id, Version = item.Version, Title = _title, IsDone = _isDone });
            _status = result.Message;
            _detail = null; // 保存・競合・失効・監査拒否の後に旧DTOを再送させない。
            _title = "";
            _isDone = false;
            if (result.Status == LearningEditStatus.Success)
            {
                _id = item.Id;
                await LoadDetailCoreAsync(item.Id); // 成功時も最新の認可・監査を通る。
            }
        }
        finally { _gate.End(); }
    }
}
