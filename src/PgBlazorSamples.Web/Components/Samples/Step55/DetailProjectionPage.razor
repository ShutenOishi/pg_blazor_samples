@page "/learn/55"
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject LearningDbService Database
@inject LearningEditService Edits

<PageTitle>ステップ55：詳細表示とN+1対策｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">学習順075（旧ステップ55） / 第15組</p>
<h1>必要なときだけ関連情報つき詳細を取得する</h1>
<p>一覧は少ない列だけ取得し、選択した1行の詳細を単一のSQLへ射影します。</p>
<MudPaper Class="pa-4">
    <MudButton OnClick="ReloadAsync">一覧を再読み込み</MudButton>
    <p role="status" data-testid="step55-state">@_message</p>
    <MudTable T="LearningTaskRow" Items="_rows" Dense="true">
        <HeaderContent><MudTh>課題名</MudTh><MudTh>操作</MudTh></HeaderContent>
        <RowTemplate><MudTd>@context.Title</MudTd>
            <MudTd><MudButton OnClick="@(() => ShowAsync(context.Id))">詳細を見る</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
    @if (_detail is not null)
    {
        <section aria-label="選択した課題の詳細">
            <h2>学習順075：WinForms＋Dapperとの比較</h2>
    <table data-testid="stage06-compare-075"><thead><tr><th>観点</th><th>WinForms＋Dapper</th><th>Blazor＋EF Core 10</th></tr></thead>
    <tbody><tr><td>詳細表示</td><td>JOINした列を単票のDTOへMappingする</td><td>AsNoTrackingとSelectで1行の詳細を取得</td></tr>
    <tr><td>操作と行の安全性</td><td>既存DB台帳の都度認可をSQLの境界に置く</td><td>学習用DTOと本番の都度認可・監査を明確に区別する</td></tr></tbody></table>
    <p>このステップの実コード2例、操作手順、失敗時の切り分け、演習と詳しい解答は日本語教材に掲載しています。実AD・既存台帳の本番認可はこの練習画面には未実装です。</p>
    <h2>@_detail.Title</h2>
            <dl>
                <dt>分類</dt><dd>@_detail.CategoryName</dd>
                <dt>期限</dt><dd>@(_detail.DueDate?.ToString("yyyy/MM/dd") ?? "未設定")</dd>
                <dt>開始時刻</dt><dd>@(_detail.StartTime?.ToString("HH:mm") ?? "未設定")</dd>
                <dt>完了</dt><dd>@(_detail.IsDone ? "はい" : "いいえ")</dd>
                <dt>版番号</dt><dd>@_detail.Version</dd>
            </dl>
        </section>
    }
</MudPaper>
<section class="lesson-details">
    <h2>関連データの取得</h2>
    <p>分類はAsNoTrackingとSelectでDTOへ射影します。子テーブルが多数ある業務では1対多の詳細一覧を別ページングで取得し、無制限のIncludeや行ごとのDB照会を避けます。</p>
    <p>この画面に業務認可はありません。実務では一覧だけでなく、詳細を開くサービスでも権限を検査します。</p>
</section>
<div class="page-navigation"><a href="/learn/54">前へ：ステップ54</a><a href="/learn/column/55">第15組の復習：編集・競合・詳細</a></div>
@code {
    private IReadOnlyList<LearningTaskRow> _rows = [];
    private LearningTaskDetail? _detail;
    private string _message = "一覧を読み込みます。";

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        var list = await Database.SearchAsync();
        _rows = list.Rows;
        _detail = null;
        _message = list.Message;
    }
    private async Task ShowAsync(long id)
    {
        var result = await Edits.GetDetailAsync(id);
        _detail = result.Item;
        _message = result.Message;
    }
}
