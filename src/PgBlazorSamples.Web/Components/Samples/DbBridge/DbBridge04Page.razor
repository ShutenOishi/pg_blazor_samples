@using Microsoft.EntityFrameworkCore
@using PgBlazorSamples.Web.Data
@inject IDbContextFactory<LearningDbContext> Factory
@page "/learn/db-bridge-04"
<PageTitle>学習順58：既存DB・ビュー・キーなしモデル・FDWを扱う｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">第5段階 / 学習順58</p><h1>既存DB・ビュー・キーなしモデル・FDWを扱う</h1>
<p>既存DBのビュー、キーなしモデル、FDWの扱いを学びます。匿名画面から利用者台帳を読み取りません。</p>
<section class="lesson-details"><button type="button" @onclick="Inspect">キーなしモデル定義を確認する</button>
<p role="status" data-testid="dbbridge04-state">@state</p>
<ul><li>キーなしのビューは通常の追跡更新対象にできません。</li>
<li>FDWは外部側の権限・性能・通信エラーを考慮します。</li>
<li>外部DBの更新と監査の原子性を保証できない場合は更新を拒否します。</li></ul>
<p>認証でユーザー名が得られても、個別の認可は既存台帳を根拠に行います。</p></section>
<div class="page-navigation"><a href="/learn/39">前へ</a><a href="/learn/db-bridge-05">次へ</a></div>
@code {
    private string state = "未確認";
    // 認可のない画面から台帳の行を取得せず、EFのモデル定義だけを参照する。
    private void Inspect()
    {
        using var db = Factory.CreateDbContext();
        var model = db.Model.FindEntityType(typeof(ExistingUserAccessRow));
        state = model is not null && model.FindPrimaryKey() is null
            ? "既存台帳のモデルはキーなし（HasNoKey）。データは取得していません。"
            : "モデルを確認できません。";
    }
}
