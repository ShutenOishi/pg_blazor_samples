@using Microsoft.EntityFrameworkCore
@using PgBlazorSamples.Web.Data
@inject IDbContextFactory<LearningDbContext> Factory
@page "/learn/db-bridge-05"
<PageTitle>学習順59：FromSql／SqlQueryのパラメーターとDapper併用｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">第5段階 / 学習順59</p><h1>FromSql／SqlQueryのパラメーターとDapper併用</h1>
<p>FromSqlInterpolatedとSqlQueryで、利用者の値がSQL構文に連結されずパラメーター化される様子を確認します。</p>
<section class="lesson-details"><label for="dbbridge05-term">検索値</label>
<input id="dbbridge05-term" @bind="term" />
<button type="button" @onclick="Generate">安全なSQLを生成する</button>
<p role="status" data-testid="dbbridge05-state">@state</p>
<h2>FromSqlの生成SQL</h2><pre data-testid="dbbridge05-fromsql" style="white-space:pre-wrap;overflow-wrap:anywhere">@fromSql</pre>
<h2>SqlQueryの生成SQL</h2><pre data-testid="dbbridge05-sqlquery" style="white-space:pre-wrap;overflow-wrap:anywhere">@sqlQuery</pre>
<p>DBへの接続は行いません。実業務でDapperを併用する場合も値をパラメーター化し、認可を共通サービスで強制します。</p></section>
<div class="page-navigation"><a href="/learn/db-bridge-04">前へ</a><a href="/learn/40">次へ</a></div>
@code {
    private string term = "' OR 1=1 --";
    private string state = "生成前";
    private string fromSql = "生成前";
    private string sqlQuery = "生成前";
    private void Generate()
    {
        using var db = Factory.CreateDbContext();
        var keyword = term;
        fromSql = db.Tasks.FromSqlInterpolated(
            $"SELECT xmin, * FROM learning_task WHERE title = {keyword}").AsNoTracking().ToQueryString();
        sqlQuery = db.Database.SqlQuery<int>(
            $"SELECT COUNT(*)::int AS \"Value\" FROM learning_task WHERE title = {keyword}").ToQueryString();
        state = "パラメーター化したSQLを生成しました。実DBは操作していません。";
    }
}
