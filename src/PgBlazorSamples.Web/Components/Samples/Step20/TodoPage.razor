@page "/learn/20"
@using PgBlazorSamples.Application
@inject ITodoService Tasks

<PageTitle>ステップ20：DI総合演習｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">ステップ20 / DI総合演習</p>
<h1>DIサービスで学習課題の一覧を操作する</h1>
<p>画面は <code>ITodoService</code> を使うだけです。保存先を知らずに課題の追加・完了を扱います。</p>
<section class="lesson-details">
  <h2>課題を追加する</h2>
  <label class="field-label" for="step20-title">練習用の課題名（1〜40文字）</label>
  <input class="text-input" id="step20-title" maxlength="40" @bind="newTitle" @bind:event="oninput" />
  <button type="button" @onclick="Add">課題を追加する</button>
  <p role="status" data-testid="step20-message">@message</p>
</section>
<section class="lesson-details">
  <h2>現在の課題</h2>
  <p>登録件数：<strong data-testid="step20-count">@Tasks.GetAll().Count</strong> 件</p>
  <ul>
    @foreach (var item in Tasks.GetAll())
    {
      <li @key="item.Id">
        <label><input type="checkbox" checked="@item.IsComplete" @onchange="() => Toggle(item.Id)" />
          <span>@item.Title</span></label>
      </li>
    }
  </ul>
</section>
<section class="lesson-details">
  <h2>学習のポイント</h2>
  <p>サービスはScoped登録です。DBは使わず、同じcircuitに限って練習用課題を保持します。画面を切断すると内容が失われる場合があります。</p>
  <p>続くコラムでは自作のDIを復習し、ライブラリが提供するDIの読み方も確認します。</p>
</section>
<div class="page-navigation"><a href="/learn/19">前へ：ステップ19</a><a href="/learn/column/20">コラム04：復習へ</a><a href="/learn/column/library-di">コラム05：ライブラリDIへ</a></div>
@code {
    private string newTitle = "";
    private string message = "";

    private void Add()
    {
        var success = Tasks.TryAdd(newTitle, out message);
        if (success) newTitle = "";
    }

    private void Toggle(Guid id) => Tasks.Toggle(id);
}
