@page "/learn/53"
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject LearningDbService Database
@inject LearningEditService Edits
@inject IDialogService Dialogs

<PageTitle>ステップ53：選択と一括操作｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">学習順073（旧ステップ53） / 第15組</p>
<h1>選択した課題をまとめて完了にする</h1>
<p>架空課題の練習専用です。上限50件、重複を拒否し、途中で1件でも変更されれば全体を中止します。</p>
<MudPaper Class="pa-4">
    <MudButton OnClick="ReloadAsync">一覧を再読み込み</MudButton>
    <MudButton Color="Color.Primary" Disabled="@(_selected.Count == 0 || _saving)"
               OnClick="CompleteAsync">選択した @_selected.Count 件を完了にする</MudButton>
    <p role="status" data-testid="step53-state">@_message</p>
    <MudTable T="LearningTaskRow" Items="_rows" Dense="true">
        <HeaderContent><MudTh>選択</MudTh><MudTh>課題名</MudTh><MudTh>状態</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd><input type="checkbox" aria-label="@($"{context.Title}を選択")"
                          checked="@_selected.ContainsKey(context.Id)"
                          @onchange="e => SetSelected(context, e.Value is true)" /></MudTd>
            <MudTd>@context.Title</MudTd>
            <MudTd>@(context.IsDone ? "完了" : "未完了")</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>
<section class="lesson-details">
    <h2>学習順073：WinForms＋Dapperとの比較</h2>
    <table data-testid="stage06-compare-073"><thead><tr><th>観点</th><th>WinForms＋Dapper</th><th>Blazor＋EF Core 10</th></tr></thead>
    <tbody><tr><td>一括更新</td><td>選択行のIdと版をトランザクションに渡す</td><td>DBトランザクション内で全行を読み直す</td></tr>
    <tr><td>操作と行の安全性</td><td>既存DB台帳の都度認可をSQLの境界に置く</td><td>学習用DTOと本番の都度認可・監査を明確に区別する</td></tr></tbody></table>
    <p>このステップの実コード2例、操作手順、失敗時の切り分け、演習と詳しい解答は日本語教材に掲載しています。実AD・既存台帳の本番認可はこの練習画面には未実装です。</p>
    <h2>部分失敗の契約を先に決める</h2>
    <p>本ステップは原子的な全件成功・全件取消です。各行の読込時xminを送信し、DBトランザクション内で全件を検証して保存します。認可はこのサンプルには未実装であり、業務での一括承認へ転用するにはサーバー側の各行認可と監査が必要です。</p>
</section>
<div class="page-navigation"><a href="/learn/52">前へ：ステップ52</a><a href="/learn/54">次へ：ステップ54</a></div>
@code {
    private IReadOnlyList<LearningTaskRow> _rows = [];
    private readonly Dictionary<long, uint> _selected = new();
    private string _message = "一覧を読み込みます。";
    private bool _saving;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _selected.Clear();
        var list = await Database.SearchAsync();
        _rows = list.Rows;
        _message = list.Message + " 選択は解除しました。";
    }

    private void SetSelected(LearningTaskRow row, bool selected)
    {
        if (selected) _selected[row.Id] = row.Version;
        else _selected.Remove(row.Id);
    }

    private async Task CompleteAsync()
    {
        if (_saving || _selected.Count == 0) return;
        bool? agreed = await Dialogs.ShowMessageBoxAsync("一括更新の確認",
            $"{_selected.Count}件を完了にしますか？",
            yesText: "更新する", cancelText: "中止");
        if (agreed != true) { _message = "中止しました。"; return; }
        _saving = true;
        try
        {
            var chosen = _selected.Select(s => new LearningSelection(s.Key, s.Value)).ToArray();
            var result = await Edits.CompleteSelectedAsync(chosen);
            await ReloadAsync(); // 成否に関係なく古い選択を破棄する。
            _message = result.Message + " 選択を解除しました。";
        }
        finally { _saving = false; }
    }
}
