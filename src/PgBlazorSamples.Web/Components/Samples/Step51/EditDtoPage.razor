@page "/learn/51"
@using Microsoft.AspNetCore.Components.Forms
@using PgBlazorSamples.Web.Data
@using PgBlazorSamples.Web.Services.Learning
@inject LearningDbService Database
@inject LearningEditService Edits

<PageTitle>ステップ51：編集DTOと検証｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">学習順71（旧ステップ51） / 第15組</p>
<h1>一覧で選んだ課題をDTOで編集する</h1>
<p>開発用PostgreSQL 18を使用します。DbContextを画面に保持せず、版番号つきDTOだけを保持します。</p>
<MudPaper Class="pa-4">
    <MudButton OnClick="RefreshAsync">一覧を再読み込み</MudButton>
    <p role="status" data-testid="step51-state">@_message</p>
    <MudTable T="LearningTaskRow" Items="@_rows" Dense="true">
        <HeaderContent><MudTh>課題名</MudTh><MudTh>操作</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="課題名">@context.Title</MudTd>
            <MudTd DataLabel="操作"><MudButton OnClick="@(() => OpenAsync(context.Id))">この行を編集</MudButton></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>課題がないか、DBが未設定です。</MudText></NoRecordsContent>
    </MudTable>
    @if (_draft is not null)
    {
        <EditForm Model="_draft" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="step51-title">課題名</label>
                <InputText id="step51-title" @bind-Value="_draft.Title" class="form-control" />
                <ValidationMessage For="@(() => _draft.Title)" />
            </div>
            <label><InputCheckbox @bind-Value="_draft.IsDone" /> 完了</label>
            <p>読込時の版番号：@_draft.Version</p>
            <MudButton ButtonType="ButtonType.Submit" Disabled="_saving" Color="Color.Primary">変更を保存</MudButton>
        </EditForm>
    }
</MudPaper>
<section class="lesson-details">
    <h2>学習順71：WinForms＋Dapperとの比較</h2>
    <table data-testid="stage06-compare-71"><thead><tr><th>観点</th><th>WinForms＋Dapper</th><th>Blazor＋EF Core 10</th></tr></thead>
    <tbody><tr><td>編集DTO</td><td>TextBoxとDapperの更新SQLを直接使う</td><td>EditFormとSaveAsyncで入力再検証・保存</td></tr>
    <tr><td>操作と行の安全性</td><td>既存DB台帳の都度認可をSQLの境界に置く</td><td>学習用DTOと本番の都度認可・監査を明確に区別する</td></tr></tbody></table>
    <p>このステップの実コード2例、操作手順、失敗時の切り分け、演習と詳しい解答は日本語教材に掲載しています。実AD・既存台帳の本番認可はこの練習画面には未実装です。</p>
    <h2>実務での使い分け</h2>
    <p>編集用DTOは一覧行とは別のコピーです。保存時に必ずサーバー側で入力を検証し、xminが違う場合は上書きせず最新情報の確認を求めます。</p>
</section>
<div class="page-navigation"><a href="/learn/column/50">前へ：第14組の復習</a><a href="/learn/52">次へ：ステップ52</a></div>
@code {
    private IReadOnlyList<LearningTaskRow> _rows = [];
    private LearningEditInput? _draft;
    private string _message = "一覧を読み込みます。";
    private bool _saving;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        var list = await Database.SearchAsync();
        _rows = list.Rows;
        _message = list.Message;
    }

    private async Task OpenAsync(long id)
    {
        var loaded = await Edits.LoadAsync(id);
        _draft = loaded.Item;
        _message = loaded.Message;
    }

    private async Task SaveAsync()
    {
        if (_saving || _draft is null) return;
        _saving = true;
        try
        {
            var saved = await Edits.SaveAsync(_draft);
            _message = saved.Message;
            if (saved.Status == LearningEditStatus.Success)
            {
                _draft = saved.Current;
                await RefreshAsync();
                _message = saved.Message;
            }
        }
        finally { _saving = false; }
    }
}
