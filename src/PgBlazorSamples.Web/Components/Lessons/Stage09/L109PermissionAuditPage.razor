@page "/learn/109"
@using PgBlazorSamples.Web.Services.Learning
@inject SecuredLearningService Business
@page "/learn/capstone-04"
<PageTitle>学習順109：認証済み本人と既存台帳による権限・監査｜Blazor ステップアップ学習</PageTitle>
<p class="eyebrow">第9段階 / 学習順109</p>
<h1>認証済み本人と既存台帳による権限・監査</h1>

<p>Active Directoryは本人認証とユーザー名にだけ利用し、業務権限は既存PostgreSQL台帳で操作ごとに判定します。教材から実利用者を登録しません。</p>
<section class="lesson-details">
<button type="button" @onclick="CheckAsync">現在の権限と監査の前提を確認</button>
<p role="status" data-testid="capstone04-result">@_status</p>
<button type="button" @onclick="EditAccessAsync">編集操作の権限を再確認する</button>
<p role="status" data-testid="capstone04-edit">@_editStatus</p>
<button type="button" @onclick="ListAsync">認可付き部署一覧を取得する</button>
<p role="status" data-testid="capstone04-list">@_list</p>
<button type="button" @onclick="SummaryAsync">認可付き集計を取得する</button>
<p role="status" data-testid="capstone04-summary">@_summary</p>
<p>未認証・台帳未登録・無効・権限不足・監査不成立では、一覧も集計も表示しません。認可成立時のみ監査の永続化後に結果を返します。</p>
<table><thead><tr><th scope="col">検査条件</th><th scope="col">処理</th></tr></thead><tbody>
<tr><td>認証されたWindows主体</td><td>信頼できる認証方式の本人だけを認める</td></tr>
<tr><td>既存台帳と部署の権限</td><td>現在の権限に対応する業務範囲のみ返す</td></tr>
<tr><td>編集と監査</td><td>正本のロック、更新、監査が原子的でない場合は更新しない</td></tr>
<tr><td>匿名のCI</td><td>必ず拒否し、実ADの試験成功と混同しない</td></tr>
</tbody></table><table data-testid="capstone-compare-109"><thead><tr><th scope="col">観点</th><th scope="col">WinForms＋Dapper</th><th scope="col">Blazor／EF Core／既存台帳</th></tr></thead><tbody><tr><td>操作</td><td>フォームイベントでSQLを呼ぶ</td><td>Razorから認可済み業務サービスに委譲する</td></tr><tr><td>認可</td><td>既存DB台帳を照会する</td><td>認証済み本人・部署・操作と行単位を都度確認する</td></tr><tr><td>安全拒否</td><td>例外・排他・監査を確認する</td><td>権限失効、xmin競合、監査不成立、FDW原子性不明では拒否する</td></tr></tbody></table><p>解説は <code>docs/course-v3/lessons/capstone-04.md</code> を参照してください。実AD/IIS/Kerberos/FDWと1万人超負荷の実機受入は別途必要です。</p>
</section>
<div class="page-navigation"><a href="/learn/108">前へ</a><a href="/learn/110">次へ</a></div>
@code {
    private string _status = "未確認です。";
    private string _editStatus = "未確認です。";
    private string _list = "未取得です。";
    private string _summary = "未集計です。";
    private async Task CheckAsync()
    {
        var permit = await Business.AuthorizeAsync();
        _status = permit.Unit is null
            ? permit.Message
            : "業務の閲覧権限を確認しました。業務データと本人の名前は表示していません。";
    }
    private async Task EditAccessAsync()
    {
        // 画面のチェックではなく最新の正本を操作ごとに照会する。ここでは更新しない。
        var permit = await Business.AuthorizeAsync(forEdit: true);
        _editStatus = permit.Unit is null ? permit.Message : "現在の編集権限を確認しました。更新は実行していません。";
    }
    private async Task ListAsync()
    {
        var result = await Business.LoadPageAsync(new(0, 10));
        _list = $"{result.Message} 表示件数：{result.Rows.Count}件／総件数：{result.TotalCount}件";
    }
    private async Task SummaryAsync()
    {
        var result = await Business.CountByDoneAsync();
        _summary = result.Rows.Count == 0 ? result.Message
            : $"{result.Message} 集計対象：{result.Rows.Sum(x => x.Count)}件";
    }
}
