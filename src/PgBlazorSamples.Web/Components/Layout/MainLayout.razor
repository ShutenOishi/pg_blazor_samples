@implements IDisposable
@inject PgBlazorSamples.Web.Services.Learning.ThemePreferenceService ThemePreference
@inherits LayoutComponentBase

@* Providerはレイアウト全体の対話型回線で共有する。 *@
<MudThemeProvider IsDarkMode="@ThemePreference.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<a class="skip-link" href="#main-content">本文へ移動</a>
<div class="app-shell">
    <header class="site-header">
        <a class="site-brand" href="/">Blazor ステップアップ学習</a>
        <span class="site-description">日本語で学ぶ業務アプリ開発</span>
    </header>

    <div class="app-content">
        <aside class="sidebar">
            <NavMenu />
        </aside>
        <main id="main-content" class="main-content" tabindex="-1">
            @Body
        </main>
    </div>

    <footer class="site-footer">
        <span>学習用のサンプルです。業務情報や実在する利用者の情報は扱いません。</span>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        // 選択したテーマを共有レイアウトへ反映する。
        ThemePreference.Changed += OnThemeChanged;
    }
    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => ThemePreference.Changed -= OnThemeChanged;
}
