<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PgBlazorSamples.Web</RootNamespace>
    <AssemblyName>PgBlazorSamples.Web</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 学習環境を再現できるよう検証対象のバージョンを固定する。 -->
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="MudBlazor.Translations" Version="3.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <!-- EF Core 10 + PostgreSQLはWebプロジェクトだけへ追加する。 -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>
</Project>
