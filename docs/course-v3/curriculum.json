  "stages": [
    {
      "name": "Web開発の前提",
      "goal": "WinFormsとブラウザー/サーバーの役割を区別し、HTTPと開発者ツールで動作を追える。",
      "pre": "C#とWindowsアプリ開発の経験。DB/AD不要。",
      "bridge": "フォームのイベントだけでは見えなかったHTTP要求・応答・DOM・HTTPSとKestrelを先に理解する。",
      "exercise": "Networkで要求と応答を観察し、HTMLの見た目を変えてサーバー側ブレークポイントを通す。",
      "next": "Razorの表示と対話を、Web側の仕組みと結び付ける。",
      "stage": 1,
      "from": 1,
      "to": 5,
      "overview": "docs/course-v3/stages/stage01.md",
      "final_review": "ci-passed"
    },
    {
      "name": "Blazorの基本と実行原理",
      "goal": "Razorの表示・イベント・コンポーネントと、SSR・SignalR・circuit・状態の違いを説明できる。",
      "pre": "第1段階。DB/AD不要。",
      "bridge": "WinFormsのイベントがローカルで完結していたのに対し、Interactive ServerではC#がサーバーで実行される。",
      "exercise": "SSRと対話型のクリック、回線切断、ライフサイクルの初期化回数と再読込を観察する。",
      "next": "DIの寿命とcircuit状態を混同せず、サービスを導入する。",
      "stage": 2,
      "from": 6,
      "to": 20,
      "overview": "docs/course-v3/stages/stage02.md",
      "final_review": "ci-passed"
    },
    {
      "name": "DI・サービスと単体テスト",
      "goal": "DI登録、インターフェイス、ライフタイム、Options、ログ、テスト、サービス分離を一つの小さな画面で説明できる。",
      "pre": "第2段階のcircuit/イベント。DB/AD不要。",
      "bridge": "WinFormsのnewと外部サービス注入を比較し、Scopedを画面操作ごとの生成と誤解しない。",
      "exercise": "固定時計をテストへ渡し、Scoped課題リストとIOptionsを利用して入力エラーを確認する。",
      "next": "UIライブラリのDI登録とProviderを理解する。",
      "stage": 3,
      "from": 21,
      "to": 30,
      "overview": "docs/course-v3/stages/stage03.md",
      "final_review": "ci-passed"
    },
    {
      "name": "MudBlazorとブラウザーの業務UI",
      "goal": "日本語入力・一覧・ダイアログ・通知に加え、JS連携、ファイル操作、エラー、アクセシビリティを判断できる。",
      "pre": "第3段階のDI。DB/ADなしで練習できる。",
      "bridge": "DataGridViewとは違い、Items全件保持とサーバー側取得を分け、ブラウザーのファイル・DOMに必要な手段を選ぶ。",
      "exercise": "架空の課題データで検索・確認・アップロード制約・CSV/PDFダウンロード・キーボード操作を試す。",
      "next": "画面をPostgreSQLとEF Coreの短命DbContextへ接続する。",
      "stage": 4,
      "from": 31,
      "to": 45,
      "overview": "docs/course-v3/stages/stage04.md",
      "final_review": "ci-passed"
    },
    {
      "name": "DapperからEF Core 10・PostgreSQL 18へ",
      "goal": "既存SQLとLINQ、Npgsqlの接続プール、DbContextFactory、CRUD、型、更新競合を対応付けられる。",
      "pre": "第4段階の入力/UI。学習用PostgreSQL 18が必要な操作を明示する。",
      "bridge": "DapperのSQL/DTO/Executeに対してEF Coreのモデル・追跡・SaveChanges・生成SQLを実例で比較する。",
      "exercise": "同じ検索をSQLとLINQで表現し、パラメーター、トランザクション、xminによる競合を確認する。",
      "next": "一覧の取得方式を件数と操作要件で選ぶ。",
      "stage": 5,
      "from": 46,
      "to": 60,
      "overview": "docs/course-v3/stages/stage05.md"
    },
